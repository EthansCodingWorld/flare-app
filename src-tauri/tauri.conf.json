{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flare",
  "version": "0.1.0",
  "identifier": "com.flare.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "../src-ui/index.html",
    "frontendDist": "../src-ui"
  },
  "app": {
    "windows": [
      {
        "title": "Flare",
        "width": 1200,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
