    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "dialog": {},
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "RWTMJzhb1VPd257+rDjyY5r3RKVbAn71e5PyDKXLfycufDpsA6tf+Wof",
      "endpoints": [
        "https://github.com/EthansCodingWorld/flare-app/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
